# Copy to .env.playwright or run npm run test:e2e:setup to populate it.
SF_ORG_ALIAS=checkr
SF_BASE_URL=

# Browser tests derive authenticated state from the org alias and current CLI session.
# Override this if you want to target a prebuilt storage state.
SF_AUTH_FILE=.playwright/auth/salesforce.json

# Record IDs for seeded browser tests. npm run test:e2e:setup updates these.
CKR_VIEWER_RECORD_ID=
CKR_VIEWER_RECORD_OBJECT_API_NAME=Account
CKR_VIEWER_CHECKLIST_NAME=Account Onboarding
CKR_VIEWER_EXPLANATION_ITEM_LABEL=Confirm executive sponsor
CKR_VIEWER_EXISTING_EXPLANATION=Sponsor confirmed in kickoff call.

CKR_CREATE_RECORD_ID=
CKR_CREATE_RECORD_OBJECT_API_NAME=Account
CKR_CREATE_ACTION_LABEL=New Checklist
CKR_CREATE_TEMPLATE_LABEL=Account Onboarding (v1)
CKR_CREATE_DUE_DATE=2099-12-31
